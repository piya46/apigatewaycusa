{
  "name": "scicu-alumni-api-gateway",
  "version": "1.3.0",
  "private": true,
  "description": "SCICU Alumni Reunion API Gateway and LINE webhook router",
  "main": "app.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "node --test test/*.test.js",
    "test:redis": "node --test test/integration/*.test.js",
    "check": "node scripts/check.js",
    "config:check": "node scripts/check-config.js",
    "routing:check": "node scripts/check-routing.js",
    "deploy:check": "node scripts/check-deployment.js",
    "package:deploy": "node scripts/package-deploy.js",
    "dlq:replay": "node scripts/replay-dlq.js"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "supertest": "^7.1.1"
  }
}
