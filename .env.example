# Keep the application, this file, keys and logs OUTSIDE public_html.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
ENFORCE_HTTPS=true
# Only trust the actual proxy addresses; HostAtom must overwrite X-Forwarded-Proto.
TRUST_PROXY=loopback

LINE_CHANNEL_SECRET=
# Upstash Console -> database -> Connect -> TCP. Copy the complete TLS URL.
# Use the endpoint, password and port shown there; REST URL/token are not used.
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
INTERNAL_API_TOKEN=
PING_SECRET=
# Optional bootstrap URLs, used only before the first routing configuration.
# Manage apps and matching rules at /admin/routes after setup.
# SSO_WEBHOOK_URL=https://sso.reunion.scicu-alumni.com/api/line/mfa
# CHATBOT_WEBHOOK_URL=https://chatbot.cusa.com/webhook

FORWARD_TIMEOUT_MS=4000
REDIS_COMMAND_TIMEOUT_MS=1500
WORKER_POLL_MS=1000
WORKER_LEASE_MS=30000
QUEUE_MAX_LENGTH=5000
SHUTDOWN_TIMEOUT_MS=15000

LOG_DIR=logs
LOG_LEVEL=info
LOG_RETENTION_DAYS=14
LOG_MAX_SIZE=10m

# CUSA SSO v1.4: opaque tokens + PKCE. Required for the admin console.
# API key scopes: identity:read, token:introspect, token:revoke.
# Give the administrator the service-specific role "admin" (roles array).
SSO_ORIGIN=https://sso.reunion.scicu-alumni.com
SSO_APPLICATION_ID=
SSO_API_KEY=
SSO_REDIRECT_URI=https://api.reunion.scicu-alumni.com/auth/sso/callback
SSO_TIMEOUT_MS=4000

# Optional RS256 support for future /v1 resources; CUSA SSO does not issue JWTs.
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=
JWT_AUDIENCE=
